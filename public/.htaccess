ErrorDocument 404 /404ed/

RewriteEngine On

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)([^/])$ /$1$2/ [L,R=301]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^([^/]+)/$ index.php?page=$1 [L,NC]
RewriteRule ^([^/]+)/([^/]+)/([^/]+)/$ index.php?page=$1&$2=$3 [L,NC]
RewriteRule ^([^/]+)/([^/]+)/([^/]+)/([^/]+)/([^/]+)/$ index.php?page=$1&$2=$3&$4=$5 [L,NC]
RewriteRule ^([^/]+)/([^/]+)/([^/]+)/([^/]+)/([^/]+)/([^/]+)/([^/]+)/$ index.php?page=$1&$2=$3&$4=$5&$6=$7 [L,NC]
RewriteRule ^([^/]+)/([^/]+)/([^/]+)/([^/]+)/([^/]+)/([^/]+)/([^/]+)/([^/]+)/([^/]+)/$ index.php?page=$1&$2=$3&$4=$5&$6=$7&$8=$9 [L,NC]
